func main(){
    int a = 7
    int b = 3
    string size = a > 5 ? "big" : "small"
    Type[a " is " size], \n
    Type["inline: " (b > 5 ? "big" : "small")], \n
    int grade = 85
    string letter = grade >= 90 ? "A" : grade >= 80 ? "B" : grade >= 70 ? "C" : "F"
    Type["grade " grade " is " letter], \n
    Type[(a == 7 ? 'y' : 'n')], \n
    if (size == (a > 100 ? "small" : "big")) Type["string compare with ternary"], \n
    Type[tern(1) " " tern(0)], \n
    show(a > b ? "a is bigger" : "b is bigger")
    string names[2] = ["ann", "bob"]
    names[b == 3 ? 2 : 1] = a > 5 ? "yes" : "no"
    Type[names[1] " " names[2]], \n
    int k = 0
    while (k < 4) {
        Type[(k % 2 == 0 ? "even " : "odd ")]
        k <- k + 1
    }
    Type[""], \n
}

func tern(int k) -> string {
    return k == 1 ? "one" : "zero"
}

func show(string s){
    Type["show: " s], \n
}