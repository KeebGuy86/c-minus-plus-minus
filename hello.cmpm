import <io>

func main(){
    Int x = 6
    Int y = 3
    Int z

    Char op

    Type["Enter Operator: "]
    Read[op]

    switch(op){
        case '+':
            z = x + y
            Type["The sum is " z], \n
        case '-':
            z = x - y
            Type["The difference is " z], \n
        case '*', 'x':
            z = x * y
            Type["The product is " z], \n
        default:
            Type["Unknown Operator!"], \n
    }
}